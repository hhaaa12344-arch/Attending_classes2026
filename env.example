# توكن البوت الذي تحصل عليه من @BotFather في تليجرام
BOT_TOKEN=123456789:AAExampleTokenHere

# رابط الاتصال بقاعدة بيانات PostgreSQL
# على Railway: أضف Plugin باسم PostgreSQL داخل مشروعك، وسيوفر هذا المتغير تلقائيًا باسم DATABASE_URL
# لا حاجة لكتابته يدويًا إذا كنت تنشر على Railway وربطت قاعدة البيانات بنفس المشروع
DATABASE_URL=postgresql://user:password@host:5432/dbname

# معرفات تليجرام (Telegram user id) الخاصة بالأدمن، مفصولة بفواصل
# احصل على معرفك عبر إرسال أي رسالة للبوت @userinfobot
ADMIN_IDS=111111111,222222222

# عدد الساعات التي يبقى فيها الدرس متاحًا لتسجيل الحضور بعد تفعيله (اختياري، الافتراضي 24)
LESSON_ACTIVE_HOURS=24
